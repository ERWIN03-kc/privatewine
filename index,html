<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#050807"><title>MASWINE</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Sora:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css"></head><body>
<div class="wrap">
<header><div class="logo"><svg width="26" height="26" viewBox="0 0 32 32"><path d="M16 2l12 7v14l-12 7-12-7V9z" fill="none" stroke="#22c55e" stroke-width="2"/><path d="M10 21V11l6 6 6-6v10" fill="none" stroke="#22c55e" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg></div>
<div><b>MASWINE</b><span>Kirim file jadi link</span></div></header>
<main class="card" id="main">
<div class="seg"><button id="t1" class="on">Bikin Link</button><button id="t2">Pencarian</button></div>
<section id="p1">
<label>Nama</label><input id="n" maxlength="100" placeholder="Contoh: Video liburan">
<label>Deskripsi</label><textarea id="d" rows="3" maxlength="500" placeholder="Tulis deskripsi bebas"></textarea>
<input id="f" type="file" hidden>
<div class="drop" id="drop"></div>
<button class="btn pri full" id="go">Bikin link</button>
<div class="prog" id="prog"><div id="bar"></div></div>
<div class="res" id="res" hidden></div>
</section>
<section id="p2" hidden>
<div class="sbox"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
<input id="q" placeholder="Ketik nama persis atau tempel link"></div>
<div id="list"></div>
</section>
</main>
<div id="view" hidden></div>
<p class="foot">MASWINE &copy; 2026</p>
</div>
<div class="toast" id="toast"></div>
<script type="module" src="app.js"></script></body></html>
